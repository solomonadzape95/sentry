{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.health/contracts/ingest_run.schema.json",
  "title": "IngestRun",
  "type": "object",
  "required": [
    "source_id",
    "started_at",
    "finished_at",
    "status",
    "rows_read",
    "rows_accepted",
    "rows_rejected",
    "outputs"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string" },
    "source_url": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["success", "partial", "failed"] },
    "rows_read": { "type": "integer", "minimum": 0 },
    "rows_accepted": { "type": "integer", "minimum": 0 },
    "rows_rejected": { "type": "integer", "minimum": 0 },
    "date_min": { "type": ["string", "null"], "format": "date" },
    "date_max": { "type": ["string", "null"], "format": "date" },
    "licence": { "type": ["string", "null"] },
    "checksum": { "type": ["string", "null"] },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "context": { "type": ["string", "null"] }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": { "type": "object" },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "format", "rows"],
        "properties": {
          "path": { "type": "string" },
          "format": { "enum": ["csv", "json", "jsonl", "parquet", "text", "pdf"] },
          "rows": { "type": "integer", "minimum": 0 },
          "sha256": { "type": ["string", "null"] }
        }
      }
    }
  }
}
