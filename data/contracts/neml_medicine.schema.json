{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisec.health/contracts/neml_medicine.schema.json",
  "title": "NEMLMedicine",
  "type": "object",
  "required": ["source_id", "name", "source_url"],
  "properties": {
    "source_id": { "type": "string" },
    "name": { "type": "string", "minLength": 3 },
    "atc_code": { "type": ["string", "null"], "pattern": "^[A-Z][0-9]{2}[A-Z]{2}[0-9]{2}$" },
    "description": { "type": ["string", "null"] },
    "section": { "type": ["string", "null"] },
    "edition": { "type": "string" },
    "source_url": { "type": "string" },
    "is_illustrative": { "type": "boolean", "default": false },
    "retrieved_at": { "type": "string", "format": "date-time" }
  }
}
