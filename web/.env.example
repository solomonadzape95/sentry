DATABASE_URL="file:./dev.db"

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Demo profile only. Every seeded persona uses this password.
DEMO_PASSWORD="sentry-demo-2026"

# Enforce Auth.js sign-in while keeping the demo dataset and clock.
# Defaults to false under APP_PROFILE=demo and true otherwise.
AUTH_REQUIRED="false"

