# Postgres profile (optional)
# Start the database: docker compose up -d postgres
# Then use this as DATABASE_URL and run the db:pg:* scripts.
DATABASE_URL="postgresql://aisec:aisec@localhost:5433/aisec?schema=public"

# Hosted Postgres (Render, etc.):
#   - use the provider's external URL, not its internal hostname
#   - append ?sslmode=require
#   - on Vercel, set DATABASE_URL in the project settings, not in this file
# See docs/DEPLOYMENT.md for the full runbook.
