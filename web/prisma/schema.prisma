// Cheta — predictive medicine supply intelligence
// SQLite for the hackathon build. Schema is Postgres-compatible apart from the
// provider line; JSON payloads are stored as strings for portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Facility {
  id                  String   @id @default(cuid())
  name                String
  shortName           String
  type                String // PHC | GENERAL | PRIVATE | PHARMACY
  ownership           String // PUBLIC | PRIVATE | FAITH_BASED
  address             String
  lga                 String
  state               String
  latitude            Float
  longitude           Float
  phone               String?
  contactName         String?
  status              String   @default("ACTIVE")
  bedCount            Int?
  // Provenance and reference identifiers. The hackathon demo facilities are
  // illustrative; the fields are ready for GRID3/NHFR/DHIS2 matches.
  sourceId            String?
  nhfrId              String?
  grid3Id             String?
  level               String?
  catchmentPopulation Int?
  isIllustrative      Boolean  @default(true)
  createdAt           DateTime @default(now())

  members        FacilityMember[]
  batches        InventoryBatch[]
  movements      StockMovement[]
  consumption    ConsumptionRecord[]
  purchaseOrders PurchaseOrder[]
  forecasts      Forecast[]
  alerts         StockAlert[]
  transfersOut   TransferRequest[]   @relation("TransferFrom")
  transfersIn    TransferRequest[]   @relation("TransferTo")
  auditLogs      AuditLog[]
  invitations    Invitation[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  role          String // INVENTORY_OFFICER | FACILITY_MANAGER | NETWORK_AUTHORITY | SUPPLIER
  title         String
  phone         String?
  passwordHash  String?
  status        String    @default("ACTIVE") // INVITED | ACTIVE | SUSPENDED
  emailVerified DateTime?
  image         String?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  // Bumped on password change, role change and "sign out everywhere". A JWT
  // carrying an older epoch is rejected by the session guard.
  sessionEpoch  Int       @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  // Required for SUPPLIER accounts: a supplier login always represents an
  // organisation, and every order query is scoped by this link.
  supplierId    String?

  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  memberships        FacilityMember[]
  movements          StockMovement[]
  requestedTransfers TransferRequest[]    @relation("TransferRequestedBy")
  approvedTransfers  TransferRequest[]    @relation("TransferApprovedBy")
  auditLogs          AuditLog[]
  accounts           Account[]
  sessions           Session[]
  invitationsSent    Invitation[]         @relation("InvitationInvitedBy")
  passwordResets     PasswordResetToken[]
}

model FacilityMember {
  id         String   @id @default(cuid())
  userId     String
  facilityId String
  role       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
}

model Medicine {
  id            String   @id @default(cuid())
  name          String
  genericName   String
  strength      String
  form          String
  category      String // ANTIMALARIAL | ANTIBIOTIC | ANALGESIC | ORS | CHRONIC | RESPIRATORY | OTHER
  unit          String
  packSize      Int
  barcode       String?  @unique
  atcCode       String?
  essential     Boolean  @default(true)
  storage       String   @default("AMBIENT") // AMBIENT | COLD_CHAIN
  leadTimeDays  Int      @default(14)
  shelfLifeDays Int      @default(730)
  createdAt     DateTime @default(now())

  batches        InventoryBatch[]
  movements      StockMovement[]
  consumption    ConsumptionRecord[]
  purchaseOrders PurchaseOrder[]
  forecasts      Forecast[]
  alerts         StockAlert[]
  transfers      TransferRequest[]
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  type         String // DISTRIBUTOR | CENTRAL_STORE | MANUFACTURER
  leadTimeDays Int
  phone        String?
  email        String?
  createdAt    DateTime @default(now())

  batches        InventoryBatch[]
  purchaseOrders PurchaseOrder[]
  users          User[]
  invitations    Invitation[]
}

model InventoryBatch {
  id                String   @id @default(cuid())
  facilityId        String
  medicineId        String
  supplierId        String?
  batchNumber       String
  quantityReceived  Int
  quantityRemaining Int
  expiryDate        DateTime
  receivedAt        DateTime
  unitCostNgn       Float    @default(0)
  status            String   @default("ACTIVE") // ACTIVE | DEPLETED | EXPIRED | QUARANTINED
  createdAt         DateTime @default(now())

  facility Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  movements StockMovement[]
  transfers TransferRequest[]

  @@index([facilityId, medicineId])
  @@index([expiryDate])
}

model StockMovement {
  id            String   @id @default(cuid())
  facilityId    String
  medicineId    String
  batchId       String?
  type          String // RECEIPT | ISSUE | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT | COUNT | EXPIRY
  quantity      Int // signed: positive in, negative out
  balanceAfter  Int
  reason        String?
  reference     String?
  performedById String?
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  facility    Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine    Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  performedBy User?           @relation(fields: [performedById], references: [id])

  @@index([facilityId, occurredAt])
  @@index([medicineId, occurredAt])
}

model ConsumptionRecord {
  id             String   @id @default(cuid())
  facilityId     String
  medicineId     String
  date           DateTime
  quantity       Int
  wasStockout    Boolean  @default(false)
  source         String   @default("SYSTEM") // SYSTEM | DERIVED | IMPORT
  isIllustrative Boolean  @default(true)
  createdAt      DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([facilityId, medicineId, date])
  @@index([date])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  reference   String    @unique
  facilityId  String
  supplierId  String
  medicineId  String
  quantity    Int
  status      String    @default("CONFIRMED") // DRAFT | SUBMITTED | CONFIRMED | DELIVERED | CANCELLED
  orderedAt   DateTime
  expectedAt  DateTime
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
}

model DiseaseObservation {
  id             String   @id @default(cuid())
  disease        String // MALARIA | CHOLERA | MENINGITIS | LASSA_FEVER | RESPIRATORY
  state          String
  lga            String?
  periodStart    DateTime
  periodEnd      DateTime
  cases          Int
  source         String
  sourceUrl      String?
  isIllustrative Boolean  @default(true)
  isDerived      Boolean  @default(false)
  isImputed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([disease, state, lga, periodStart])
  @@index([disease, periodStart])
}

model WeatherObservation {
  id          String   @id @default(cuid())
  location    String
  state       String
  date        DateTime
  rainfallMm  Float
  tempMaxC    Float
  tempMinC    Float
  humidityPct Float
  source      String
  createdAt   DateTime @default(now())

  @@unique([location, date])
  @@index([date])
}

model Forecast {
  id          String   @id @default(cuid())
  facilityId  String
  medicineId  String
  model       String // SEASONAL_NAIVE | MOVING_AVERAGE | RIDGE | XGBOOST
  modelLabel  String
  horizonDays Int
  mae         Float
  wape        Float
  bias        Float
  confidence  String // HIGH | MEDIUM | LOW
  dataPoints  Int
  lowData     Boolean  @default(false)
  trainedAt   DateTime
  createdAt   DateTime @default(now())

  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  points   ForecastPoint[]

  @@unique([facilityId, medicineId])
  @@index([medicineId])
}

model ForecastPoint {
  id         String   @id @default(cuid())
  forecastId String
  date       DateTime
  predicted  Float
  lower80    Float
  upper80    Float
  lower95    Float
  upper95    Float

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@unique([forecastId, date])
  @@index([date])
}

model StockAlert {
  id                  String    @id @default(cuid())
  facilityId          String
  medicineId          String
  type                String // STOCKOUT_RISK | LOW_STOCK | EXPIRY | OVERSTOCK
  severity            String // CRITICAL | HIGH | MEDIUM | LOW
  status              String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  predictedStockoutAt DateTime?
  quantityAtRisk      Int?
  message             String
  createdAt           DateTime  @default(now())
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
}

model TransferRequest {
  id             String    @id @default(cuid())
  reference      String    @unique
  fromFacilityId String
  toFacilityId   String
  medicineId     String
  batchId        String?
  quantity       Int
  status         String    @default("RECOMMENDED") // RECOMMENDED | PENDING_APPROVAL | APPROVED | IN_TRANSIT | COMPLETED | REJECTED | CANCELLED
  reason         String?
  note           String?
  requestedById  String?
  approvedById   String?
  recommendedAt  DateTime  @default(now())
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  fromFacility Facility        @relation("TransferFrom", fields: [fromFacilityId], references: [id], onDelete: Cascade)
  toFacility   Facility        @relation("TransferTo", fields: [toFacilityId], references: [id], onDelete: Cascade)
  medicine     Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch        InventoryBatch? @relation(fields: [batchId], references: [id])
  requestedBy  User?           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?           @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  facilityId String?
  userId     String?
  entity     String
  entityId   String
  action     String
  detail     String?
  createdAt  DateTime @default(now())

  facility Facility? @relation(fields: [facilityId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([facilityId, createdAt])
}

model DataSource {
  id        String    @id
  name      String
  kind      String // OBSERVED | DERIVED | REFERENCE | OBSERVED_PRIOR | GATED
  coverage  String?
  url       String?
  licence   String?
  status    String    @default("ACTIVE") // ACTIVE | PLANNED | GATED
  lastRunAt DateTime?
  createdAt DateTime  @default(now())

  runs IngestRun[]
}

model IngestRun {
  id           String    @id @default(cuid())
  sourceId     String
  status       String // success | partial | failed
  rowsRead     Int       @default(0)
  rowsAccepted Int       @default(0)
  rowsRejected Int       @default(0)
  dateMin      DateTime?
  dateMax      DateTime?
  startedAt    DateTime
  finishedAt   DateTime?
  warnings     String?
  errors       String?
  createdAt    DateTime  @default(now())

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
}

model ModelRun {
  id           String   @id @default(cuid())
  runAt        DateTime @default(now())
  model        String
  horizonDays  Int
  seriesCount  Int
  overallMae   Float
  overallWape  Float
  overallBias  Float
  baselineWape Float
  notes        String?
}

// ---------------------------------------------------------------------------
// Authentication (Auth.js v5 + Prisma adapter)
//
// Sessions use the JWT strategy, so the Session table is unused today. It is
// included so OAuth or database sessions can be enabled without a migration.
// Tokens are stored hashed; the raw value only ever goes in the invitation or
// reset link.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        String // INVENTORY_OFFICER | FACILITY_MANAGER | NETWORK_AUTHORITY | SUPPLIER
  title       String?
  facilityId  String?
  supplierId  String?
  invitedById String?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  facility  Facility? @relation(fields: [facilityId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time bootstrap marker. The demo seed deletes this row when it starts and
/// recreates it after every table is written, so an interrupted seed is retried
/// automatically on the next service start.
model SeedState {
  id       String   @id
  seededAt DateTime @default(now())
}
