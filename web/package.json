{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs",
    "build": "next build",
    "prestart": "node scripts/ensure-env.mjs",
    "start": "next start",
    "lint": "eslint",
    "predb:push": "node scripts/ensure-env.mjs",
    "db:push": "prisma db push",
    "predb:seed": "node scripts/ensure-env.mjs",
    "predb:reset": "node scripts/ensure-env.mjs",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:pg:schema": "node scripts/make-postgres-schema.mjs",
    "db:pg:generate": "npm run db:pg:schema && prisma generate --schema=prisma/schema.postgres.prisma",
    "db:pg:push": "npm run db:pg:schema && prisma db push --schema=prisma/schema.postgres.prisma",
    "db:pg:seed": "tsx prisma/seed.ts",
    "db:pg:setup": "npm run db:pg:generate && npm run db:pg:push && npm run db:pg:seed",
    "db:pg:reset": "npm run db:pg:schema && prisma db push --force-reset --schema=prisma/schema.postgres.prisma && npm run db:pg:seed",
    "db:sqlite:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jsbarcode": "^3.12.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
